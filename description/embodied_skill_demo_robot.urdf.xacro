<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="embodied_skill_demo_robot">
  <!-- Self-contained presentation model: primitive geometry only, no lab assets. -->
  <material name="chassis_blue"><color rgba="0.08 0.28 0.55 1.0"/></material>
  <material name="arm_orange"><color rgba="0.95 0.42 0.08 1.0"/></material>
  <material name="wheel_dark"><color rgba="0.08 0.08 0.10 1.0"/></material>
  <material name="joint_gray"><color rgba="0.45 0.48 0.52 1.0"/></material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.24"/>
      <geometry><box size="0.80 0.52 0.20"/></geometry>
      <material name="chassis_blue"/>
    </visual>
  </link>

  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.13" length="0.08"/></geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <joint name="left_wheel_mount" type="fixed">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.30 0.14"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.13" length="0.08"/></geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <joint name="right_wheel_mount" type="fixed">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.30 0.14"/>
  </joint>

  <link name="arm_base">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry><cylinder radius="0.12" length="0.30"/></geometry>
      <material name="joint_gray"/>
    </visual>
  </link>
  <joint name="arm_base_mount" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin xyz="-0.20 0 0.34"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry><box size="0.50 0.10 0.10"/></geometry>
      <material name="arm_orange"/>
    </visual>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="arm_base"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.30"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.35" upper="0.60" effort="10" velocity="2.0"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <origin xyz="0.20 0 0"/>
      <geometry><box size="0.40 0.085 0.085"/></geometry>
      <material name="arm_orange"/>
    </visual>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.50 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.20" upper="2.10" effort="10" velocity="2.0"/>
  </joint>

  <link name="tool_link">
    <visual>
      <geometry><cylinder radius="0.07" length="0.12"/></geometry>
      <material name="joint_gray"/>
    </visual>
  </link>
  <joint name="tool_mount" type="fixed">
    <parent link="forearm_link"/>
    <child link="tool_link"/>
    <origin xyz="0.43 0 0" rpy="0 1.5708 0"/>
  </joint>
</robot>
