Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Baseline Robot1
        - /EmbodiedSkill Robot1
        - /Comparison Overlay1
      Splitter Ratio: 0.50
    Tree Height: 520
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.48
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 105; 110; 118
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /comparison/baseline/robot_description
      Enabled: true
      Name: Baseline Robot
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /comparison/embodied/robot_description
      Enabled: true
      Name: EmbodiedSkill Robot
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /embodied_skill/comparison_markers
      Name: Comparison Overlay
      Namespaces: {}
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
  Enabled: true
  Global Options:
    Background Color: 27; 30; 37
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.8
      Focal Point:
        X: 0.45
        Y: 0
        Z: 0.50
      Name: A/B Recording View
      Near Clip Distance: 0.01
      Pitch: 0.58
      Target Frame: map
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 30
  Y: 30
